          <property name="leftMargin"><number>9</number></property>
          <property name="topMargin"><number>9</number></property>
          <property name="rightMargin"><number>9</number></property>
          <property name="bottomMargin"><number>9</number></property>
          <property name="spacing"><number>6</number></property>
          <item>
           <layout class="QHBoxLayout" name="cleanDataRow" stretch="1,0">
            <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QLabel" name="cleanDataHint">
              <property name="text"><string>Clean Data erases everything this terminal keeps: tickets, sales, supplies, cards and the cashier's session. The machine settings stay. The terminal then downloads everything again. It is refused while records wait for the upload.</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="sub" stdset="0"><bool>true</bool></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="cleanDataButton">
              <property name="text"><string>Clean Data</string></property>
              <property name="minimumSize"><size><width>200</width><height>48</height></size></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="clearConfigRow" stretch="1,0">
            <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QLabel" name="clearConfigHint">
              <property name="text"><string>Clear Config erases the machine settings: the server address, the printer, the converter port, the tanks of the nozzles, the card reader, the upload mode and the options. The data stays. The terminal then asks for the server again.</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="sub" stdset="0"><bool>true</bool></property>
             </widget>
            </item>
