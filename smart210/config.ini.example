; Copy to config.ini next to the program. Every key is optional.
language=en
fullscreen=true
width=1280
height=720
;fontDir=/path/to/fonts
;themeFile=/path/to/theme.qss   ; a copy of resources/theme.qss to edit: the app reads it again whenever it is saved
;dataDir=/path/to/sdcard/smart210
;downloadMinutes=10
;setSystemClock=true   ; set the board's clock from the server's (UTC) and write it to the RTC chip; needs root. The default is true for a Linux program running as root, false otherwise
;printWidthDots=576
;printBarcode=image
;logo=/path/to/logo.png
;ticketFont=/path/to/titlefont.ttf
;printEnd=cut
;ticketTitle_sale=Gas Station Fuel Ticket
; the title and the footer of the ticket as ready black-and-white bitmaps (192 x 48 dots, printed at that size, centred): title.bmp and footer.bmp next to the program
; are used when they exist. A title of one kind: ticketTitleBitmap_sale (also _self, _other, _ticket_loan, _remainder, _card). No file: the title text and the logo.
;ticketTitleBitmap=/path/to/title.bmp
;ticketFooterBitmap=/path/to/footer.bmp

; listen for the RS485 converter of the nozzle boards (the port is set on Machine Config); false for trying screens on a PC
boards=true

; the supplier's barcode scanner is read in the background: its exact name from /proc/bus/input/devices (the N: Name="..." line),
; and, to tell it from another scanner of the same name, a part of its USB port (the P: Phys= line)
supplierScannerName=SCANNER SCANNER
;supplierScannerPhys=usb-s5p-ehci-1.1
