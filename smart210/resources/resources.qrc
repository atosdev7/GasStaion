<RCC>
    <qresource prefix="/i18n">
        <file alias="smart210_shell_en.qm">../i18n/smart210_shell_en.qm</file>
        <file alias="smart210_login_en.qm">../i18n/smart210_login_en.qm</file>
        <file alias="smart210_sales_en.qm">../i18n/smart210_sales_en.qm</file>
        <file alias="smart210_supplies_en.qm">../i18n/smart210_supplies_en.qm</file>
        <file alias="smart210_remainders_en.qm">../i18n/smart210_remainders_en.qm</file>
        <file alias="smart210_cards_en.qm">../i18n/smart210_cards_en.qm</file>
        <file alias="smart210_dispensers_en.qm">../i18n/smart210_dispensers_en.qm</file>
        <file alias="smart210_ticket_debt_en.qm">../i18n/smart210_ticket_debt_en.qm</file>
        <file alias="smart210_review_en.qm">../i18n/smart210_review_en.qm</file>
        <file alias="smart210_settings_en.qm">../i18n/smart210_settings_en.qm</file>
        <file alias="smart210_sync_en.qm">../i18n/smart210_sync_en.qm</file>
    </qresource>
    <qresource prefix="/ticket">
        <file alias="title.bmp">ticket/title.bmp</file>
        <file alias="title_sale.bmp">ticket/title_sale.bmp</file>
        <file alias="title_self.bmp">ticket/title_self.bmp</file>
        <file alias="title_other.bmp">ticket/title_other.bmp</file>
        <file alias="title_ticket_loan.bmp">ticket/title_ticket_loan.bmp</file>
        <file alias="title_remainder.bmp">ticket/title_remainder.bmp</file>
        <file alias="title_card.bmp">ticket/title_card.bmp</file>
        <file alias="footer.bmp">ticket/footer.bmp</file>
    </qresource>
    <qresource prefix="/theme">
        <file alias="theme.qss">theme.qss</file>
    </qresource>
    <qresource prefix="/migrations">
        <file alias="001_initial.sql">migrations/001_initial.sql</file>
        <file alias="002_card_transactions.sql">migrations/002_card_transactions.sql</file>
        <file alias="003_remainder_comment.sql">migrations/003_remainder_comment.sql</file>
